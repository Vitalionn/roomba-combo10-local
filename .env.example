# Copy to .env (chmod 600). Filled by `explore.py discover` (IP + BLID) and `cloud_password.py` (password).
ROOMBA_IP=192.168.1.50
ROOMBA_BLID=0123456789ABCDEF0123456789ABCDEF
ROOMBA_PASSWORD=:1:1234567890:AbCdEfGhIjKlMnOp
# Address the web app binds to (docker-compose). Use your server's LAN or VPN IP, never 0.0.0.0.
BIND_IP=127.0.0.1
